# Copiez ce fichier en .env.local. Ne partagez jamais vos secrets.
# Sans DATABASE_URL, les portfolios sont conservés dans .data/ en développement.
# En production, configurez PostgreSQL/Neon ou activez explicitement le stockage local.
DATABASE_URL=
# Si l’application est derrière un reverse proxy HTTPS, définissez son adresse publique :
# APP_ORIGIN=https://talentproof.votre-domaine.tg
ALLOW_LOCAL_STORAGE=false
WHISPER_URL=http://127.0.0.1:8000
OLLAMA_URL=http://127.0.0.1:11434
# Petit modèle pour un premier essai. qwen3:4b améliore la qualité mais demande plus de RAM.
OLLAMA_MODEL=qwen3:0.6b
# Si vous utilisez npm run ai:local plutôt qu’Ollama :
# LLAMA_URL=http://127.0.0.1:8081
# Facultatif sur localhost. À configurer sur les deux services si vous les séparez.
VOICE_SERVICE_TOKEN=
